<Window x:Class="Clipsa.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ajustes de Clipsa" Width="520" Height="650" WindowStartupLocation="CenterOwner" Background="#171A26" Foreground="#F7F8FC" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Image Source="/Clipsa;component/Brand/clipsa-icon.png" Width="34" Height="34" Margin="0,0,10,0"/><StackPanel><TextBlock Text="Ajustes de Clipsa" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Atajos, guardado y comportamiento" Foreground="#AEB5C7"/></StackPanel></StackPanel>
        <TextBlock x:Name="ModeText" Foreground="#A99BFF" Margin="0,0,0,14"/>
        <TextBlock Text="Pantalla de captura" FontSize="16" FontWeight="SemiBold"/>
        <ComboBox x:Name="MonitorBox" Margin="0,10,0,16"/>
        <TextBlock Text="Atajos" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Captura completa" VerticalAlignment="Center"/><Button x:Name="FullButton" Grid.Row="0" HorizontalAlignment="Right" Width="220" Click="Full_Click" Background="#292E42" Foreground="#F7F8FC"/><TextBlock Text="Captura de región" Grid.Row="1" VerticalAlignment="Center"/><Button x:Name="RegionButton" Grid.Row="1" HorizontalAlignment="Right" Width="220" Click="Region_Click" Background="#292E42" Foreground="#F7F8FC"/><TextBlock Text="Captura con scroll" Grid.Row="2" VerticalAlignment="Center"/><Button x:Name="ScrollButton" Grid.Row="2" HorizontalAlignment="Right" Width="220" Click="Scroll_Click" Background="#292E42" Foreground="#F7F8FC"/></Grid>
        <TextBlock Text="Pulsa el atajo para cambiarlo. Esc cancela; Supr lo desactiva. Para Impr Pant + 1, 2 o 3, mantenla pulsada, pulsa el número y suelta Impr Pant." TextWrapping="Wrap" Foreground="#AEB5C7" FontSize="11" Margin="0,8,0,0"/>
        <Button Content="Usar Impr Pant + 1 / 2 / 3" Click="PrintPreset_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,10,0,0"/>
        <Separator Margin="0,20"/><TextBlock Text="Guardado" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10"><TextBox x:Name="FolderBox" Width="350"/><Button Content="Elegir carpeta" Click="Folder_Click" Margin="8,0,0,0" Padding="10,4"/></StackPanel><TextBlock Text="Si no eliges otra, Clipsa usa la carpeta actual." Foreground="#AEB5C7" FontSize="11"/>
        <Separator Margin="0,18"/><TextBlock Text="Comportamiento" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="KeepTrayBox" Content="Mantener Clipsa en la bandeja al cerrar" Margin="0,12,0,6" Foreground="#F7F8FC"/><TextBlock Text="El botón X ocultará la ventana y Clipsa seguirá disponible junto al reloj." Foreground="#AEB5C7" FontSize="11" TextWrapping="Wrap"/><CheckBox x:Name="StartupBox" Content="Iniciar Clipsa con Windows" Margin="0,14,0,6" Foreground="#F7F8FC"/>
        <Separator Margin="0,18"/><TextBlock Text="Scroll y apariencia" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Scroll manual: desplaza tú el contenido y haz pausas breves entre tramos." Foreground="#AEB5C7" TextWrapping="Wrap" Margin="0,10"/><StackPanel Orientation="Horizontal"><TextBlock Text="Intervalo de detección" VerticalAlignment="Center" Width="160"/><TextBox x:Name="DelayBox" Width="55" Text="350"/><TextBlock Text=" ms" Foreground="#AEB5C7" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Transparencia glass" VerticalAlignment="Center" Width="160"/><Slider x:Name="GlassSlider" Width="150" Minimum="0" Maximum="100" Value="68" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/><TextBlock x:Name="GlassBox" Width="40" Text="{Binding Value, ElementName=GlassSlider, StringFormat={}{0:0}}" VerticalAlignment="Center" TextAlignment="Right"/><TextBlock Text=" %" Foreground="#AEB5C7" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Tamaño de Clipsa" VerticalAlignment="Center" Width="160"/><TextBox x:Name="ScaleBox" Width="55" Text="100"/><TextBlock Text=" %" Foreground="#AEB5C7" VerticalAlignment="Center"/></StackPanel>
        <CheckBox x:Name="RecoveryBox" Content="Recuperar capturas tras un cierre inesperado" Margin="0,16,0,6" Foreground="#F7F8FC"/>
        <TextBlock Text="El cierre normal elimina las capturas temporales. La recuperación es opcional y local." Foreground="#AEB5C7" FontSize="11" TextWrapping="Wrap"/>
        <Separator Margin="0,18"/>
        <TextBlock Text="Actualizaciones y datos" FontSize="16" FontWeight="SemiBold"/>
        <TextBox x:Name="UpdateFeedBox" Margin="0,10" ToolTip="Repositorio público de GitHub o URL HTTPS del manifiesto de actualizaciones"/>
        <TextBlock Text="Repositorio GitHub o manifiesto HTTPS (por ejemplo, https://github.com/peesejota/clipsa)." Foreground="#AEB5C7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <CheckBox x:Name="StartupUpdatesBox" Content="Avisar de nuevas versiones al iniciar Clipsa" Foreground="#F7F8FC" Margin="0,0,0,10"/>
        <Button x:Name="UpdatesButton" Content="Buscar actualizaciones" Click="Updates_Click" HorizontalAlignment="Left" Padding="10,5"/>
        <TextBlock x:Name="StorageText" Foreground="#AEB5C7" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,6"/>
        <Button Content="Abrir ajustes e informes" Click="Storage_Click" HorizontalAlignment="Left" Padding="10,5"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancelar" Click="Cancel_Click" Padding="18,7" Margin="0,0,8,0"/><Button Content="Guardar" Click="Save_Click" Padding="18,7" Background="#9B8CFF"/></StackPanel>
    </StackPanel></ScrollViewer>
</Window>
