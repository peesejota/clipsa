<Window x:Class="Clipsa.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clipsa" Icon="/Clipsa;component/Brand/clipsa-icon.png" Height="276" MinWidth="240" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid x:Name="PanelRoot">
    <Border x:Name="GlassBackground" CornerRadius="0,0,28,28" IsHitTestVisible="False"/>
    <Border x:Name="RootBorder" Background="Transparent" CornerRadius="0,0,28,28" BorderBrush="#A0FFFFFF" BorderThickness="1" Padding="24,12,24,20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{StaticResource Ink}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Button x:Name="UpdateBadge" Grid.Column="0" Content="Nueva versión ↓" Click="Settings_Click" Visibility="Collapsed" ToolTip="Actualización disponible. Abrir Ajustes para descargar o actualizar." Background="#FFA99BFF" Foreground="#FF171A26" Padding="4,0"/>
                <StackPanel x:Name="BrandTitle" Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Clipsa;component/Brand/clipsa-icon.png" Width="22" Height="22" Margin="0,0,7,0"/><TextBlock Text="CLIPSA" Foreground="{StaticResource Ink}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <ScrollViewer x:Name="CompactScroll" Grid.Column="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="8,0" PreviewMouseWheel="HorizontalWheel">
                    <ItemsControl x:Name="CompactCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Padding="2" Margin="3,0" Background="#FF272638" BorderBrush="#FFA99BFF" BorderThickness="1" CornerRadius="5" Tag="{Binding}" PreviewMouseLeftButtonDown="Card_MouseDown" PreviewMouseMove="Card_MouseMove" MouseLeftButtonUp="Compact_Click" ToolTip="Clic: editar · Clic derecho: gestionar · Arrastrar: exportar o reordenar">
                                <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Editar" Tag="{Binding}" Click="Annotate_Click"/><MenuItem Header="Abrir" Tag="{Binding}" Click="Open_Click"/>
                                    <MenuItem Header="Copiar" Tag="{Binding}" Click="Copy_Click"/><MenuItem Header="Guardar" Tag="{Binding}" Click="Save_Click"/><MenuItem Header="Eliminar" Tag="{Binding}" Click="Delete_Click"/>
                                </ContextMenu></Border.ContextMenu>
                                <Image Source="{Binding Preview}" Width="43" Height="22" Stretch="Uniform" IsHitTestVisible="False"/>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="⚙" Click="Settings_Click" ToolTip="Configurar Clipsa" Width="28" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0"/><Button x:Name="CollapseButton" Content="⌃" Click="Collapse_Click" ToolTip="Encoger o extender" Width="28" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0"/><Button Content="×" Click="ClosePanel_Click" ToolTip="Ocultar Clipsa" Width="28" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" FontSize="18"/></StackPanel>
            </Grid>
            <Grid x:Name="RopeRow" Grid.Row="1" Margin="0,3,0,0"><Border Height="1" Background="#D8D5E6" VerticalAlignment="Center"/></Grid>
            <ScrollViewer x:Name="CardsScroll" Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="HorizontalWheel">
                <ItemsControl x:Name="Cards" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Width="168" Height="190" Margin="0,0,14,0" Tag="{Binding}" PreviewMouseLeftButtonDown="Card_MouseDown" PreviewMouseLeftButtonUp="Card_MouseUp" PreviewMouseMove="Card_MouseMove">
                            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0"><Rectangle Width="7" Height="25" RadiusX="3" RadiusY="3" Fill="#D6D7E1" Stroke="#8E91A4" StrokeThickness="1" HorizontalAlignment="Center"/><Ellipse Width="12" Height="12" Fill="#B99EFF" Stroke="#F2EDFF" StrokeThickness="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"/></Grid>
                            <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="15" Padding="7"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="270" Opacity="0.28" Color="#000000"/></Border.Effect><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions><Border CornerRadius="10" ClipToBounds="True" Background="#24151A2A"><Image Source="{Binding Preview}" Stretch="Uniform"/></Border><DockPanel Grid.Row="1" VerticalAlignment="Center"><Button Content="↗" Tag="{Binding}" Click="Open_Click" ToolTip="Abrir" Style="{StaticResource ActionButton}"/><Button Content="✎" Tag="{Binding}" Click="Annotate_Click" ToolTip="Anotar" Style="{StaticResource ActionButton}"/><Button Content="⧉" Tag="{Binding}" Click="Copy_Click" ToolTip="Copiar" Style="{StaticResource ActionButton}"/><Button Content="↓" Tag="{Binding}" Click="Save_Click" ToolTip="Guardar captura" Style="{StaticResource ActionButton}"/><Button Content="×" Tag="{Binding}" Click="Delete_Click" ToolTip="Eliminar" Style="{StaticResource ActionButton}"/></DockPanel></Grid></Border>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
    </Grid>
</Window>
