<Window x:Class="Clipsa.AnnotationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Editar captura · Clipsa" Icon="/Clipsa;component/Brand/clipsa-icon.png" Width="1100" Height="780" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#171A26" Foreground="#F7F8FC">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
  <Border Background="#E6E1F0" CornerRadius="14" Padding="10" TextElement.Foreground="#27253D"><StackPanel>
   <WrapPanel>
    <Button Content="Lápiz" Tag="Pen" Click="Tool_Click" Margin="2" Padding="8,5"/>
    <Button Content="Texto" Tag="Text" Click="Tool_Click" Margin="2" Padding="8,5" ToolTip="Pulsa sobre la imagen para añadir texto"/>
    <Button Content="Resaltador" Tag="Highlight" Click="Tool_Click" Margin="2" Padding="8,5"/>
    <Button Content="Rectángulo" Tag="Rectangle" Click="Tool_Click" Margin="2" Padding="8,5"/>
    <Button Content="Círculo" Tag="Ellipse" Click="Tool_Click" Margin="2" Padding="8,5"/>
    <Button Content="Flecha" Tag="Arrow" Click="Tool_Click" Margin="2" Padding="8,5"/>
    <Button Content="Goma" Tag="Eraser" Click="Tool_Click" Margin="2" Padding="8,5"/>
    <Button Content="Recortar" Tag="Crop" Click="Tool_Click" Margin="2" Padding="8,5"/>
    <ComboBox x:Name="CropRatio" SelectedIndex="0" Width="104" Margin="4,2" SelectionChanged="Ratio_Changed" ToolTip="Proporción del recorte">
     <ComboBoxItem Content="Libre" Tag="0"/><ComboBoxItem Content="16:9" Tag="1.7777777778"/><ComboBoxItem Content="9:16" Tag="0.5625"/><ComboBoxItem Content="1:1" Tag="1"/><ComboBoxItem Content="4:3" Tag="1.3333333333"/><ComboBoxItem Content="3:2" Tag="1.5"/>
    </ComboBox>
    <Button Content="Aplicar recorte" Click="ApplyCrop_Click" Margin="2" Padding="8,5"/>
    <Button Content="Girar 90° ↻" Click="Rotate_Click" Margin="2" Padding="8,5"/>
   </WrapPanel>
   <WrapPanel Margin="0,6,0,0">
    <Button x:Name="ColorButton" Content="Color" Click="Color_Click" Margin="2" Padding="8,4"/>
    <TextBlock Text="Texto (px)" VerticalAlignment="Center" Margin="8,0,4,0"/><TextBox x:Name="TextSizeBox" Text="28" Width="42" VerticalContentAlignment="Center"/>
    <TextBlock Text="Grosor" VerticalAlignment="Center" Margin="12,0,5,0"/><Slider x:Name="Thickness" Width="100" Minimum="2" Maximum="30" Value="5" VerticalAlignment="Center"/>
    <Button x:Name="UndoButton" Content="Deshacer" Click="Undo_Click" Margin="12,2,2,2" Padding="8,4" ToolTip="Deshacer · Ctrl+Z"/>
    <Button x:Name="RedoButton" Content="Rehacer" Click="Redo_Click" Margin="2" Padding="8,4" ToolTip="Rehacer · Ctrl+Y o Ctrl+Shift+Z"/>
    <TextBlock x:Name="ToolStatus" Text="Lápiz" Foreground="#69627E" VerticalAlignment="Center" Margin="12,0,0,0"/>
    <TextBlock x:Name="CropSizeText" Foreground="#69627E" VerticalAlignment="Center" Margin="14,0"/>
   </WrapPanel>
  </StackPanel></Border>
  <Border Grid.Row="1" Background="#252938" CornerRadius="18" Margin="0,10" Padding="12">
   <Viewbox Stretch="Uniform">
    <Grid x:Name="DrawingSurface" Background="Transparent" Focusable="True" ClipToBounds="True" MouseLeftButtonDown="DrawStart" MouseMove="DrawMove" MouseLeftButtonUp="DrawEnd" LostMouseCapture="DrawLostCapture">
     <Image x:Name="Screenshot" Stretch="Fill"/>
     <Canvas x:Name="Ink" IsHitTestVisible="False"/>
     <Canvas IsHitTestVisible="False"><Rectangle x:Name="CropSelection" Stroke="#A99BFF" StrokeThickness="2" StrokeDashArray="4" Fill="#227B61FF" Visibility="Collapsed"/></Canvas>
    </Grid>
   </Viewbox>
  </Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
   <Button Content="Borrar anotaciones" Click="Clear_Click" Padding="14,6" Margin="0,0,8,0"/>
   <Button Content="Cancelar" Click="Cancel_Click" Padding="14,6" Margin="0,0,8,0"/>
   <Button Content="Guardar cambios" Click="Save_Click" Padding="16,6" Background="#A99BFF"/>
  </StackPanel>
 </Grid>
</Window>
